<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CheckCar.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:CheckCar.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="CheckCar">

    <TabBar>
        <ShellContent
            Title="Inicio"
            Route="dashboard"
            ContentTemplate="{DataTemplate views:DashboardPage}" />

        <ShellContent
            Title="Vehículos"
            Route="vehicles"
            ContentTemplate="{DataTemplate views:VehiclesPage}" />

        <ShellContent
            Title="Reportes"
            Route="reports"
            ContentTemplate="{DataTemplate views:ReportsPage}" />

        <ShellContent
            Title="Más"
            Route="more"
            ContentTemplate="{DataTemplate views:MorePage}" />
    </TabBar>

</Shell>
