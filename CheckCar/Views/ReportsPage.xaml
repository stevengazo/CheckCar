<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CheckCar.Views.ReportsPage"
             Title="Reportes">
    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="12">
        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label Text="Reportes" Style="{StaticResource PageTitle}" />
            <Label Text="Captura salidas y entradas. Funciona sin conexión." Style="{StaticResource Caption}" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" Spacing="10">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0" Text="Nueva salida" Style="{StaticResource PrimaryButton}" Clicked="OnNewExit" />
                <Button Grid.Column="1" Text="Nueva entrada" Style="{StaticResource SecondaryButton}" Clicked="OnNewEntry" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                <Label x:Name="PendingLabel" Grid.Column="0" Style="{StaticResource Caption}" VerticalOptions="Center" />
                <Button Grid.Column="1" x:Name="SyncButton" Text="Sincronizar" Style="{StaticResource OutlineButton}" Clicked="OnSync" />
            </Grid>
        </VerticalStackLayout>

        <RefreshView Grid.Row="2" x:Name="Refresh" Refreshing="OnRefresh">
            <CollectionView x:Name="ReportsList">
                <CollectionView.EmptyView>
                    <Label Text="Sin reportes locales todavía." Style="{StaticResource Caption}"
                           HorizontalOptions="Center" Margin="0,24" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="0,4">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Type}" FontAttributes="Bold" />
                                <Label Grid.Row="1" Grid.Column="0" Text="{Binding CarPlate}" Style="{StaticResource Caption}" />
                                <Label Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Text="{Binding Status}"
                                       VerticalOptions="Center" FontSize="12" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
